# Integration test configuration for go-filemaker.
#
# Copy to .env and fill in. .env is gitignored; this template is committed.
#   cp .env.example .env
#
# The integration suite (integration_test.go, build tag `integration`) reads
# these. Load them and run with:
#   set -a; source .env; set +a
#   go test -tags=integration -run Integration -v ./...
# or: make integration

# Required ------------------------------------------------------------------

# Host, with or without scheme (https is assumed when omitted).
FM_HOST=https://fms.example.com

# Database name.
FM_DATABASE=MyDatabase

# Account credentials.
FM_USERNAME=apiuser
FM_PASSWORD=changeme

# Optional ------------------------------------------------------------------

# IANA time zone used to interpret date/timestamp fields on read-back. When set,
# the WithLocation timestamp round-trip test runs; otherwise it skips. Every
# other test runs with the default location, UTC.
# FM_LOCATION=Europe/Stockholm

# Set to 1 to log every HTTP request/response to stderr (auth redacted) while the
# tests run. Handy for debugging a failure against the live host.
# FM_DEBUG=1

# Set to 1 to allow a plaintext http:// host (local development only).
# FM_ALLOW_INSECURE=1
